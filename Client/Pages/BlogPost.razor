@page "/BlogPost"
@page "/BlogPost/{Id:int}"
@using Blog.Shared.Entities
@inject HttpClient _http


<h1>  Post  </h1>

@if (blogEntry == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1> @blogEntry.Header</h1>

    <p> @blogEntry.Body </p>

    <table class="table">
        <thead>
            <tr>
                <th>Tags</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tags in blogEntry.Tags)
            {
                <tr>
                    <td>@tags</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private BlogEntry blogEntry;

    protected override async Task OnInitializedAsync()
    {
        if(Id != 0)
        {
            Console.WriteLine($"Id is {Id}");
            blogEntry = await _http.GetFromJsonAsync<BlogEntry>($"BlogEntry/{Id}");
        }
        else
        {
            blogEntry = await _http.GetFromJsonAsync<BlogEntry>("BlogEntry");
        }
    }
}
